# ============================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ============================================

# Interfaces de red
AP_IFACE=wlxc83a35b5a9f5
INTERNET_IFACE=wlp2s0

# Configuración WiFi
WIFI_SSID=RouterFirewall
WIFI_PASSWORD=SecurePass123
WIFI_CHANNEL=6

# Red del punto de acceso
AP_NETWORK=192.168.50.0/24
AP_GATEWAY=192.168.50.1
AP_DHCP_START=192.168.50.10
AP_DHCP_END=192.168.50.100

# ============================================
# MODELO Y SERVICIOS
# ============================================

# Modelo a utilizar: ml_flows, simulated_flows, dl_packets
# - ml_flows: Modelo ML con Random Forest (flows)
# - simulated_flows: Modelo simulado para testing (flows)
# - dl_packets: Modelo Deep Learning (packets/pcap)
MODEL_TYPE=dl_packets

# URLs de los modelos
MODEL_ML_URL=http://localhost:5001
MODEL_SIMULATED_URL=http://localhost:8000
MODEL_DL_URL=http://localhost:5002

# Puerto de cada servicio
MODEL_ML_PORT=5001
MODEL_SIMULATED_PORT=8000
MODEL_DL_PORT=5002
FIREWALL_PORT=5000
DASHBOARD_PORT=8081

# ============================================
# CAPTURA DE TRÁFICO
# ============================================

# Modo de captura: flows o packets (auto-detectado según MODEL_TYPE)
# - flows: Para model_ml y simulated-model
# - packets: Para model_dl
TRAFFIC_CAPTURE_MODE=packets

# Configuración para captura de FLOWS
FLOW_BUFFER_SIZE=100
FLOW_SEND_INTERVAL=10
FLOW_IDLE_THRESHOLD=1.0
FLOW_CLEANUP_INTERVAL=300

# Configuración para captura de PACKETS
PCAP_BUFFER_SIZE=1000
PCAP_SEND_INTERVAL=30
PACKET_STATS_INTERVAL=60

# Archivos temporales (rutas relativas, se calcularán como absolutas en config.py)
PCAP_BUFFER_FILE=tmp_pcap/traffic_buffer.pcap
FLOW_BUFFER_FILE=tmp_pcap/flow_buffer.json

# ============================================
# LOGS
# ============================================
MODEL_ML_LOG=logs/model_ml.log
MODEL_SIMULATED_LOG=logs/model_simulated.log
MODEL_DL_LOG=logs/model_dl.log
FIREWALL_LOG=logs/firewall.log
DASHBOARD_LOG=logs/dashboard.log
TRAFFIC_CAPTURE_LOG=logs/traffic_capture.log
ROUTER_LOG=logs/router.log

# ============================================
# TIMEOUTS Y REINTENTOS
# ============================================

HTTP_TIMEOUT=10
HTTP_RETRIES=3
SERVICE_START_DELAY=3
