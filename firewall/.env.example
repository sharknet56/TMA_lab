# ============================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ============================================

# Interfaces de red
AP_IFACE=wlxc83a35b5a9f5              # Interfaz WiFi que actuará como punto de acceso (AP)
INTERNET_IFACE=wlp2s0                 # Interfaz de red con acceso a Internet

# Configuración WiFi
WIFI_SSID=RouterFirewall              # Nombre de la red WiFi del punto de acceso
WIFI_PASSWORD=SecurePass123           # Contraseña para conectarse al punto de acceso
WIFI_CHANNEL=6                        # Canal WiFi (1-13, evitar canales congestionados)

# Red del punto de acceso
AP_NETWORK=192.168.50.0/24           # Rango de red del punto de acceso (CIDR notation)
AP_GATEWAY=192.168.50.1              # IP del gateway/router (este dispositivo)
AP_DHCP_START=192.168.50.10          # Primera IP asignable por DHCP
AP_DHCP_END=192.168.50.100           # Última IP asignable por DHCP

# ============================================
# MODELO Y SERVICIOS
# ============================================

# Modelo a utilizar: ml_flows, simulated_flows, dl_packets
# - ml_flows: Modelo ML con Random Forest (flows)
# - simulated_flows: Modelo simulado para testing (flows)
# - dl_packets: Modelo Deep Learning (packets/pcap)
MODEL_TYPE=ml_packets                # Tipo de modelo activo para clasificación de tráfico

# Puerto de cada servicio
MODEL_ML_PORT=5001                   # Puerto para el servidor del modelo ML
MODEL_SIMULATED_PORT=8000            # Puerto para el servidor del modelo simulado
MODEL_DL_PORT=5002                   # Puerto para el servidor del modelo DL
FIREWALL_PORT=5000                   # Puerto para el gestor del firewall
DASHBOARD_PORT=8081                  # Puerto para el dashboard web de monitoreo

# URLs de los modelos (construidas automáticamente usando los puertos definidos arriba)
MODEL_ML_URL=http://localhost:${MODEL_ML_PORT}          # URL del servidor del modelo Machine Learning
MODEL_SIMULATED_URL=http://localhost:${MODEL_SIMULATED_PORT}   # URL del servidor del modelo simulado
MODEL_DL_URL=http://localhost:${MODEL_DL_PORT}          # URL del servidor del modelo Deep Learning

# ============================================
# CAPTURA DE TRÁFICO
# ============================================

# Modo de captura: flows o packets (auto-detectado según MODEL_TYPE)
# - flows: Para model_ml y simulated-model
# - packets: Para model_dl
TRAFFIC_CAPTURE_MODE=packets         # Modo de captura de tráfico (flows o packets)

# Configuración para captura de FLOWS
FLOW_BUFFER_SIZE=100                 # Número máximo de flows almacenados en buffer antes de enviar
FLOW_SEND_INTERVAL=10                # Intervalo de envío de flows al modelo (segundos)
FLOW_IDLE_THRESHOLD=1.0              # Tiempo de inactividad para considerar un flow terminado (segundos)
FLOW_CLEANUP_INTERVAL=300            # Intervalo de limpieza de flows antiguos del buffer (segundos)

# Configuración para captura de PACKETS
PCAP_BUFFER_SIZE=1000                # Número máximo de paquetes almacenados en buffer antes de enviar
PCAP_SEND_INTERVAL=30                # Intervalo de envío de archivos PCAP al modelo (segundos)
PACKET_STATS_INTERVAL=60             # Intervalo para mostrar estadísticas de captura (segundos)

# Configuración para prediccion
MODEL_ML_LAST_FLOWS=10               # Número de flows recientes a enviar al modelo ML para clasificación

# Archivos temporales (rutas relativas, se calcularán como absolutas en config.py)
PCAP_BUFFER_FILE=tmp_pcap/traffic_buffer.pcap    # Archivo temporal para almacenar paquetes capturados
FLOW_BUFFER_FILE=tmp_pcap/flow_buffer.json       # Archivo temporal para almacenar flows agregados

# ============================================
# LOGS
# ============================================
MODEL_ML_LOG=logs/model_ml.log                   # Archivo de log del servidor del modelo ML
MODEL_SIMULATED_LOG=logs/model_simulated.log     # Archivo de log del servidor del modelo simulado
MODEL_DL_LOG=logs/model_dl.log                   # Archivo de log del servidor del modelo DL
FIREWALL_LOG=logs/firewall.log                   # Archivo de log del gestor del firewall
DASHBOARD_LOG=logs/dashboard.log                 # Archivo de log del dashboard web
TRAFFIC_CAPTURE_LOG=logs/traffic_capture.log     # Archivo de log del módulo de captura de tráfico
ROUTER_LOG=logs/router.log                       # Archivo de log del sistema de router

# ============================================
# TIMEOUTS Y REINTENTOS
# ============================================

HTTP_TIMEOUT=10                      # Tiempo máximo de espera para peticiones HTTP (segundos)
HTTP_RETRIES=3                       # Número de reintentos para peticiones HTTP fallidas
SERVICE_START_DELAY=3                # Tiempo de espera al iniciar servicios (segundos)
